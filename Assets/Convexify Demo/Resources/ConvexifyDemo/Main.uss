/* Convexify demo: dark glass panels over the 3D view */

.app {
    --text: rgb(231, 233, 238);
    --muted: rgb(138, 146, 166);
    --faint: rgba(255, 255, 255, 0.06);
    --line: rgba(255, 255, 255, 0.07);
    --surface: rgba(17, 19, 25, 0.86);
    --accent: rgb(138, 180, 255);
    --accent-hover: rgb(164, 197, 255);
    --accent-ink: rgb(14, 20, 34);

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
    font-size: 13px;
}

.viewport {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

Label {
    color: var(--text);
    padding: 0;
    margin: 0;
}

/* ---------- side panel ---------- */

/* UI Toolkit elements shrink by default: keep the fixed parts at their content size */
.brand,
.brand__text,
.panel__footer,
.section,
.section__header,
.model-card,
.chips,
.param,
.param__header,
.switch,
.segmented,
.segmented__row,
.status {
    flex-shrink: 0;
}

.panel {
    position: absolute;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 340px;
    background-color: var(--surface);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    overflow: hidden;
}

.brand {
    flex-direction: row;
    align-items: center;
    padding: 20px 20px 16px 20px;
}

.brand__mark {
    width: 22px;
    height: 22px;
    margin: 4px 16px 4px 6px;
    border-radius: 6px;
    background-color: var(--accent);
    rotate: 45deg;
    align-items: center;
    justify-content: center;
}

.brand__mark-inner {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background-color: rgb(17, 19, 25);
}

.brand__title {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.brand__subtitle {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
}

.panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.panel__scroll .unity-scroll-view__content-container {
    padding-bottom: 8px;
}

.panel__scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 2px;
}

.panel__scroll .unity-scroller__low-button,
.panel__scroll .unity-scroller__high-button {
    display: none;
}

.panel__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.panel__scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 3px;
    width: 5px;
    left: 1px;
}

.panel__scroll .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

.section {
    padding: 16px 20px 8px 20px;
    border-top-width: 1px;
    border-color: var(--line);
}

.section__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.section__title {
    font-size: 11px;
    letter-spacing: 1.6px;
    color: var(--muted);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.section__header .section__title {
    margin-bottom: 0;
}

.section__header {
    margin-bottom: 12px;
}

.caption {
    font-size: 11px;
    color: var(--muted);
    margin: 8px 0 8px 0;
    white-space: normal;
}

.panel__footer {
    padding: 12px 20px 20px 20px;
    border-top-width: 1px;
    border-color: var(--line);
}

.hint {
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
    min-height: 34px;
    margin-bottom: 12px;
}

/* ---------- model card and samples ---------- */

.model-card {
    background-color: var(--faint);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 10px;
}

.model-card__name {
    font-size: 14px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.model-card__stats {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.chip {
    height: 26px;
    margin: 0 6px 6px 0;
    padding: 0 12px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 12px;
    transition-property: background-color, color, border-color;
    transition-duration: 0.12s;
}

.chip:hover {
    background-color: var(--faint);
    color: var(--text);
}

.chip--active {
    border-color: rgba(138, 180, 255, 0.5);
    background-color: rgba(138, 180, 255, 0.12);
    color: var(--accent);
}

/* ---------- buttons ---------- */

.button {
    height: 36px;
    margin: 0;
    padding: 0 14px;
    border-radius: 10px;
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.button:active {
    scale: 0.98 0.98;
}

.button--primary {
    background-color: var(--accent);
    color: var(--accent-ink);
}

.button--primary:hover {
    background-color: var(--accent-hover);
}

.button--secondary {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text);
}

.button--secondary:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.button:disabled {
    opacity: 0.4;
}

.compute-button {
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.2s;
}

/* live update is off and the settings changed since the last run */
.compute-button--stale {
    background-color: rgba(138, 180, 255, 0.16);
    border-color: rgba(138, 180, 255, 0.7);
    color: var(--accent);
}

.compute-button--stale:hover {
    background-color: rgba(138, 180, 255, 0.26);
}

.compute-button__dot {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: var(--accent);
    display: none;
}

.compute-button--stale .compute-button__dot {
    display: flex;
}

.link-button {
    margin: 0;
    padding: 2px 6px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
    font-size: 12px;
}

.link-button:hover {
    background-color: rgba(138, 180, 255, 0.12);
}

/* ---------- parameter slider ---------- */

.param {
    margin-bottom: 12px;
}

.param__header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.param__label {
    font-size: 13px;
}

.param__value {
    font-size: 12px;
    color: var(--accent);
    -unity-font-style: bold;
}

.param__slider {
    margin: 0;
    padding: 0;
    height: 20px;
}

.param__slider .unity-base-slider__input {
    height: 20px;
}

.param__slider.unity-base-slider--horizontal .unity-base-slider__tracker {
    height: 4px;
    top: 50%;
    margin-top: -2px;
    border-radius: 2px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.param__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--accent);
}

.param__slider.unity-base-slider--horizontal .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    top: 50%;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgb(244, 246, 250);
    transition-property: scale;
    transition-duration: 0.1s;
}

.param__slider:hover .unity-base-slider__dragger {
    scale: 1.15 1.15;
}

.param__slider .unity-base-slider__dragger-border {
    display: none;
}

/* ---------- switch ---------- */

.switch {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 30px;
}

.switch__label {
    font-size: 13px;
}

.switch__track {
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.14);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.switch__knob {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(244, 246, 250);
    transition-property: translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-cubic;
}

.switch--on .switch__track {
    background-color: var(--accent);
}

.switch--on .switch__knob {
    translate: 14px 0;
}

/* ---------- segmented control ---------- */

.segmented {
    margin: 2px 0 10px 0;
}

.segmented__label {
    font-size: 13px;
    margin-bottom: 6px;
}

.segmented__row {
    flex-direction: row;
    background-color: var(--faint);
    border-radius: 9px;
    padding: 3px;
}

.segmented__item {
    flex-grow: 1;
    flex-basis: 0;
    height: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 12px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.segmented__item:hover {
    color: var(--text);
}

.segmented__item--selected {
    background-color: rgba(255, 255, 255, 0.13);
    color: var(--text);
}

/* ---------- status pill, help, loading ---------- */

.status {
    position: absolute;
    top: 16px;
    right: 16px;
    flex-direction: row;
    align-items: center;
    padding: 8px 14px 8px 12px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--surface);
}

.status__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    background-color: rgb(74, 222, 128);
}

.status--busy .status__dot {
    background-color: rgb(251, 191, 36);
}

.status--error .status__dot {
    background-color: rgb(248, 113, 113);
}

.status__text {
    font-size: 12px;
}

.help {
    position: absolute;
    right: 20px;
    bottom: 18px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.38);
}

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.loading--visible {
    display: flex;
}

.loading__text {
    padding: 10px 18px;
    border-radius: 18px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    font-size: 13px;
}

/* ---------- narrow screens: the panel becomes a bottom sheet ---------- */

.app--compact .panel {
    left: 8px;
    right: 8px;
    top: auto;
    bottom: 8px;
    width: auto;
    height: 46%;
}

.app--compact .brand {
    display: none;
}

.app--compact .status {
    top: 8px;
    right: 8px;
}

.app--compact .help {
    display: none;
}

.app--compact .hint {
    display: none;
}
